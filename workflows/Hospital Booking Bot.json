    {
      "parameters": {
        "jsCode": "const toMin = v => {\n  if (typeof v === 'number') return Math.round(v * 24 * 60);\n  const m = String(v).trim().match(/(\\d{1,2}):(\\d{2})/);\n  return m ? parseInt(m[1]) * 60 + parseInt(m[2]) : NaN;\n};\n\nconst cq = $('Telegram Trigger').first().json.callback_query;\nconst [, doctorId, date, time] = cq.data.split('|');\n\nconst doc = $('Read Doctors - Booking').all()\n  .map(i => i.json)\n  .find(d => d.DoctorID === doctorId);\n\nconst taken = $input.all().map(i => i.json).some(a =>\n  a.DoctorID === doctorId &&\n  String(a.Date) === date &&\n  a.Status !== 'Cancelled' &&\n  toMin(a.Time) === toMin(time)\n);\n\nconst patient = [cq.from.first_name, cq.from.last_name].filter(Boolean).join(' ');\nconst bookingId = 'BK' + Date.now().toString().slice(-6);\n\nlet payload;\nif (taken) {\n  payload = {\n    chat_id: cq.message.chat.id,\n    message_id: cq.message.message_id,\n    text: 'Sorry, that slot was just taken. Please choose another time.',\n    reply_markup: { inline_keyboard: [[\n      { text: '⬅ Pick another time', callback_data: `date|${doctorId}|${date}` }\n    ]] }\n  };\n} else {\n  payload = {\n    chat_id: cq.message.chat.id,\n    message_id: cq.message.message_id,\n    text:\n`✅ Booking confirmed\n\nDoctor: ${doc.Name}\nDepartment: ${doc.Department}\nDate: ${date}\nTime: ${time}\nBooking ID: ${bookingId}\n\nYou'll get a reminder the day before. Send /start to book another appointment.`\n  };\n}\n\nreturn [{\n  json: {\n    available: !taken,\n    payload,\n    booking: {\n      BookingID: bookingId,\n      CreatedAt: $now.toFormat('yyyy-MM-dd HH:mm'),\n      DoctorID: doctorId,\n      DoctorName: doc.Name,\n      Department: doc.Department,\n      Date: date,\n      Time: time,\n      PatientName: patient,\n      ChatID: cq.message.chat.id,\n      Status: 'Confirmed'\n    }\n  }\n}];"
      },
