        "jsCode": "const rows = $input.all().map(i => i.json);\nconst cq = $('Telegram Trigger').first().json.callback_query;\nconst dept = cq.data.split('|')[1];\n\nconst doctors = rows.filter(d => d.Department === dept);\n\nconst keyboard = doctors.map(d => [{\n  text: `${d.Name} (${d.Days.split('|').join(', ')})`,\n  callback_data: 'doc|' + d.DoctorID\n}]);\n\nreturn [{\n  json: {\n    chat_id: cq.message.chat.id,\n    message_id: cq.message.message_id,\n    text: `${dept}: choose a doctor`,\n    reply_markup: { inline_keyboard: keyboard }\n  }\n}];"
