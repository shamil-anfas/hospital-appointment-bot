      "parameters": {
        "jsCode": "const doctors = $input.all().map(i => i.json);\nconst departments = [...new Set(doctors.map(d => d.Department))];\n\nconst trigger = $('Telegram Trigger').first().json;\nconst chatId = trigger.message.chat.id;\nconst name = trigger.message.from.first_name;\n\nconst keyboard = departments.map(dep => [\n  { text: dep, callback_data: 'dept|' + dep }\n]);\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    text: `Hello ${name}! Which department would you like to book?`,\n    reply_markup: { inline_keyboard: keyboard }\n  }\n}];"
      },
