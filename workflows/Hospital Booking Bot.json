    {
      "parameters": {
        "jsCode": "const toMin = v => {\n  if (typeof v === 'number') return Math.round(v * 24 * 60);\n  const s = String(v).trim();\n  const m = s.match(/(\\d{1,2}):(\\d{2})/);\n  if (m) return parseInt(m[1]) * 60 + parseInt(m[2]);\n  const f = parseFloat(s);\n  return isNaN(f) ? NaN : Math.round(f * 24 * 60);\n};\nconst fmt = min =>\n  String(Math.floor(min / 60)).padStart(2, '0') + ':' + String(min % 60).padStart(2, '0');\n\nconst cq = $('Telegram Trigger').first().json.callback_query;\nconst [, doctorId, date] = cq.data.split('|');\n\nconst doctors = $('Read Doctors - Slots').all().map(i => i.json);\nconst doc = doctors.find(d => d.DoctorID === doctorId);\n\nconst booked = $input.all().map(i => i.json)\n  .filter(a => a.DoctorID === doctorId && String(a.Date) === date && a.Status !== 'Cancelled')\n  .map(a => fmt(toMin(a.Time)));\n\nconst start = toMin(doc.StartTime);\nconst end = toMin(doc.EndTime);\nconst step = parseInt(doc.SlotMinutes);\n\nconst free = [];\nfor (let t = start; t + step <= end; t += step) {\n  if (!booked.includes(fmt(t))) free.push(fmt(t));\n}\n\nconst keyboard = [];\nfor (let i = 0; i < free.length; i += 3) {\n  keyboard.push(free.slice(i, i + 3).map(t => ({\n    text: t,\n    callback_data: `slot|${doctorId}|${date}|${t}`\n  })));\n}\nkeyboard.push([{ text: '⬅ Other dates', callback_data: 'doc|' + doctorId }]);\n\nreturn [{\n  json: {\n    chat_id: cq.message.chat.id,\n    message_id: cq.message.message_id,\n    text: free.length\n      ? `${doc.Name}, ${date}: choose a time`\n      : `No free slots on ${date}. Please pick another date.`,\n    reply_markup: { inline_keyboard: keyboard }\n  }\n}];"
      },
