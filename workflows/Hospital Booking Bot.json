    {
      "parameters": {
        "jsCode": "const ctx = $('Build Prompt').first().json;\nconst ai = $input.first().json;\n\nlet result = { department: 'None', emergency: false };\ntry {\n  const raw = ai.content?.parts?.[0]?.text ?? ai.text ?? ai.output ?? '';\n  const m = String(raw).match(/\\{[\\s\\S]*\\}/);\n  if (m) result = JSON.parse(m[0]);\n} catch (e) {}\n\n// never trust the AI's department; check it against the real list\nconst dept = ctx.departments.includes(result.department) ? result.department : 'None';\nlet payload;\n\nif (result.emergency === true) {\n  payload = {\n    chat_id: ctx.chat_id,\n    text: '⚠️ This may be an emergency. Please call your local emergency number or go to the nearest emergency room right now. This bot cannot handle urgent cases.'\n  };\n} else if (dept !== 'None') {\n  payload = {\n    chat_id: ctx.chat_id,\n    text: `Based on your message, ${dept} may be the right department. This is only a routing suggestion, not medical advice.`,\n    reply_markup: { inline_keyboard: [[\n      { text: `See ${dept} doctors`, callback_data: 'dept|' + dept }\n    ]] }\n  };\n} else {\n  payload = {\n    chat_id: ctx.chat_id,\n    text: \"I couldn't match that to a department. Send /start to choose one from the list.\"\n  };\n}\n\nreturn [{ json: payload }];"
      },
