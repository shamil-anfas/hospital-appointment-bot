      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst cq = $('Telegram Trigger').first().json.callback_query;\nconst doctorId = cq.data.split('|')[1];\nconst doc = rows.find(d => d.DoctorID === doctorId);\n\nconst workDays = doc.Days.split('|');   // e.g. ['Mon','Wed','Fri']\nconst keyboard = [];\n\nfor (let i = 1; i <= 14 && keyboard.length < 5; i++) {\n  const day = $now.plus({ days: i });\n  if (workDays.includes(day.toFormat('ccc'))) {\n    keyboard.push([{\n      text: day.toFormat('ccc, dd LLL'),\n      callback_data: `date|${doctorId}|${day.toFormat('yyyy-MM-dd')}`\n    }]);\n  }\n}\n\nkeyboard.push([{ text: '⬅ Back to doctors', callback_data: 'dept|' + doc.Department }]);\n\nreturn [{\n  json: {\n    chat_id: cq.message.chat.id,\n    message_id: cq.message.message_id,\n    text: `${doc.Name} (${doc.Department}): pick a date`,\n    reply_markup: { inline_keyboard: keyboard }\n  }\n}];"
      },
